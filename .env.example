# Server Network Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# MongoDB Connection String (Required for data persistence, profiles, submissions, and leaderboard)
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/promptwars?retryWrites=true&w=majority

# AI Provider Configuration
# Options: 'simulation' (default, 100% offline, zero external keys needed)
#          'openai'     (connects to OpenAI or OpenAI-compatible endpoint)
AI_PROVIDER=simulation

# Optional Live Model Credentials (ONLY needed if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Safety Constraints & Rate Limiting
MAX_PROMPT_LENGTH=1000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
